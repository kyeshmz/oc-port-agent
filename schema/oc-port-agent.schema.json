{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "oc-port-agent CLI tracking policy",
  "description": "The version 1 policy accepted by the local CLI. JSON Schema checks structure; the CLI also validates repository, path, checkpoint, and cross-field semantics.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "upstream", "selections", "verification"],
  "properties": {
    "$schema": { "type": "string", "minLength": 1, "description": "Optional editor schema reference. The CLI validates this as metadata and does not fetch it." },
    "version": { "const": 1 },
    "baselineCommit": { "type": "string", "pattern": "^([a-f0-9]{40}|[a-f0-9]{64})$", "description": "Explicitly reviewed bootstrap baseline used only when this policy has no checkpoint. Never resolves HEAD and never replaces a saved checkpoint." },
    "allowSkillEdits": { "type": "array", "uniqueItems": true, "items": { "type": "string", "maxLength": 64, "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" }, "description": "Opt in to exact skill IDs under .opencode/skills. Explicit target paths are also required; agents, config, nested skill registrations and checkpoints remain protected." },
    "reviewMetadataPaths": { "$ref": "#/$defs/strings", "description": "Exact, already selected provenance/registry files that may record skipped reviews. No globs or scope expansion; applied decisions still need nonmetadata target changes." },
    "upstream": {
      "type": "object", "additionalProperties": false, "required": ["repository", "ref"],
      "properties": { "repository": { "type": "string", "minLength": 1 }, "ref": { "type": "string", "minLength": 1 } }
    },
    "selections": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "description", "upstreamPaths", "targetPaths", "acceptance"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "description": { "type": "string", "minLength": 1 },
          "upstreamPaths": { "$ref": "#/$defs/paths" },
          "excludeUpstreamPaths": { "$ref": "#/$defs/strings" },
          "targetPaths": { "$ref": "#/$defs/paths" },
          "acceptance": { "$ref": "#/$defs/paths" },
          "mappings": {
            "type": "array", "items": {
              "type": "object", "additionalProperties": false, "required": ["upstream", "target"],
              "properties": { "upstream": { "type": "string", "minLength": 1 }, "target": { "$ref": "#/$defs/paths" } }
            }
          },
          "instructions": {
            "$ref": "./porting-instructions.schema.json",
            "description": "Optional detailed task intent; it cannot widen declared targetPaths or change host-enforced safeguards."
          }
        }
      }
    },
    "preserve": { "$ref": "#/$defs/strings" },
    "protectedPaths": { "$ref": "#/$defs/strings" },
    "verification": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["command", "args"],
        "properties": {
          "command": { "type": "string", "minLength": 1 },
          "args": { "type": "array", "items": { "type": "string" } },
          "timeoutSeconds": { "type": "integer", "minimum": 1, "maximum": 3600 }
        }
      }
    },
    "opencode": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "executable": { "type": "string", "minLength": 1 },
        "model": { "type": "string", "minLength": 1 },
        "timeoutSeconds": { "type": "integer", "minimum": 1, "maximum": 7200 },
        "maxAttempts": { "type": "integer", "minimum": 1, "maximum": 5 },
        "steps": { "type": "integer", "minimum": 1, "maximum": 500 }
      }
    },
    "limits": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "maxCommits": { "type": "integer", "minimum": 1, "maximum": 10000 },
        "maxContextBytes": { "type": "integer", "minimum": 1000, "maximum": 50000000 }
      }
    }
  },
  "$defs": {
    "strings": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "paths": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
  }
}
