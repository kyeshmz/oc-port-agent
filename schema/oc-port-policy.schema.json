{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "oc-port-agent hosted tracking policy",
  "description": "The version 1 Cloudflare registration policy. This schema intentionally excludes the CLI-only opencode executable and settings. Runtime validation also enforces GitHub, path, checkpoint, and cross-field semantics.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "upstream", "selections", "verification"],
  "properties": {
    "$schema": {
      "type": "string",
      "minLength": 1,
      "maxLength": 10000,
      "pattern": "\\S",
      "not": { "pattern": "[\\x00-\\x1F\\x7F]" },
      "description": "Optional editor schema annotation. The hosted runtime validates and ignores this value; it never fetches it."
    },
    "version": { "const": 1 },
    "upstream": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "ref"],
      "properties": {
        "repository": { "type": "string", "minLength": 1, "maxLength": 2048 },
        "ref": { "type": "string", "minLength": 1, "maxLength": 255 }
      }
    },
    "selections": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "description", "upstreamPaths", "targetPaths", "acceptance"],
        "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "description": { "type": "string", "minLength": 1, "maxLength": 2000 },
          "upstreamPaths": { "$ref": "#/$defs/paths" },
          "excludeUpstreamPaths": { "$ref": "#/$defs/pathList" },
          "targetPaths": { "$ref": "#/$defs/paths" },
          "acceptance": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100,
            "items": { "type": "string", "minLength": 1, "maxLength": 5000 }
          },
          "mappings": {
            "type": "array",
            "maxItems": 256,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["upstream", "target"],
              "properties": {
                "upstream": { "$ref": "#/$defs/path" },
                "target": { "$ref": "#/$defs/paths" }
              }
            }
          },
          "instructions": {
            "$ref": "./porting-instructions.schema.json",
            "description": "Optional detailed task intent; it cannot widen declared targetPaths or change host-enforced safeguards."
          }
        }
      }
    },
    "preserve": { "$ref": "#/$defs/stringList" },
    "protectedPaths": { "$ref": "#/$defs/pathList" },
    "verification": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["command", "args"],
        "properties": {
          "command": { "type": "string", "minLength": 1, "maxLength": 1024 },
          "args": {
            "type": "array",
            "maxItems": 256,
            "items": { "type": "string", "minLength": 1, "maxLength": 4096 }
          },
          "timeoutSeconds": { "type": "integer", "minimum": 1, "maximum": 3600 }
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maxCommits": { "type": "integer", "minimum": 1, "maximum": 10000 },
        "maxChangedPaths": { "type": "integer", "minimum": 1, "maximum": 20000 },
        "maxFiles": { "type": "integer", "minimum": 1, "maximum": 2000 },
        "maxContextBytes": { "type": "integer", "minimum": 1000, "maximum": 50000000 },
        "maxFileBytes": { "type": "integer", "minimum": 1000, "maximum": 10000000 },
        "maxResponseBytes": { "type": "integer", "minimum": 10000, "maximum": 20000000 },
        "maxVerificationOutputBytes": { "type": "integer", "minimum": 1024, "maximum": 1000000 },
        "maxJobSeconds": { "type": "integer", "minimum": 1, "maximum": 7200 },
        "maxAttempts": { "type": "integer", "minimum": 1, "maximum": 5 },
        "maxSteps": { "type": "integer", "minimum": 1, "maximum": 500 }
      }
    }
  },
  "$defs": {
    "path": { "type": "string", "minLength": 1, "maxLength": 1024 },
    "pathList": {
      "type": "array",
      "maxItems": 256,
      "items": { "$ref": "#/$defs/path" }
    },
    "paths": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": { "$ref": "#/$defs/path" }
    },
    "stringList": {
      "type": "array",
      "maxItems": 256,
      "items": { "type": "string", "minLength": 1, "maxLength": 10000 }
    }
  }
}
