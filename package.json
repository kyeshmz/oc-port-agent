{
  "name": "oc-port-agent",
  "version": "0.1.0",
  "description": "Use OpenCode to selectively adopt and synchronize upstream functionality through reviewed changes.",
  "type": "module",
  "license": "MIT",
  "private": true,
  "bin": { "oc-port-agent": "dist/src/cli.js" },
  "files": ["dist/src", "README.md", "LICENSE", "examples", "schema"],
